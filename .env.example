# ==============================================================================
# Google Cloud Platform & BigQuery Configuration
# ==============================================================================
GCP_PROJECT_ID=
BQ_LOCATION=US

# Service account key paths (stored in gitignored secrets/ directory)
GCP_KEYFILE_AIRBYTE=./secrets/airbyte-sa.json
GCP_KEYFILE_DBT=./secrets/dbt-sa.json
GCP_KEYFILE_BI=./secrets/bi-sa.json

# BigQuery Sandbox query safety cap (1 GB = 1000000000 bytes)
BQ_MAX_BYTES_BILLED=1000000000

# ==============================================================================
# Airbyte Configuration (Local abctl)
# ==============================================================================
AIRBYTE_API_URL=http://host.docker.internal:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_CRICKET_CONNECTION_ID=
AIRBYTE_WEATHER_CONNECTION_ID=

# ==============================================================================
# Data Sources
# ==============================================================================
CRICSHEET_ZIP_URL=https://cricsheet.org/downloads/ipl_csv2.zip
IPL_MATCHES_URL=
IPL_DELIVERIES_URL=
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ==============================================================================
# Google Gemini API (Conversational BI)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
