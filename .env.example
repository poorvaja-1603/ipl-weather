# ==============================================================================
# Snowflake Configuration
# ==============================================================================
# Your Snowflake account identifier (e.g. xy12345.ap-south-1.aws or org-account)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=IPL_WH
SNOWFLAKE_DATABASE=IPL_DB

# User for dbt transformations (created in infra/snowflake_setup.sql)
SNOWFLAKE_DBT_USER=DBT_USER
SNOWFLAKE_DBT_PASSWORD=
SNOWFLAKE_DBT_ROLE=TRANSFORM_ROLE

# User for Streamlit Conversational BI (created in infra/snowflake_setup.sql)
SNOWFLAKE_BI_USER=BI_USER
SNOWFLAKE_BI_PASSWORD=
SNOWFLAKE_BI_ROLE=BI_ROLE

# ==============================================================================
# Airbyte Configuration (Local abctl)
# ==============================================================================
AIRBYTE_API_URL=http://host.docker.internal:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_CRICKET_CONNECTION_ID=
AIRBYTE_WEATHER_CONNECTION_ID=

# ==============================================================================
# Dynamic Data Source Feeds
# ==============================================================================
# Dynamic Cricket data feed (Cricsheet dynamic endpoint or GitHub raw releases)
CRICKET_MATCHES_FEED_URL=https://cricsheet.org/downloads/ipl_csv2.zip
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# ==============================================================================
# Google Gemini API (Conversational BI)
# ==============================================================================
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
